      "outputs": [],
      "source": [
        "model.compile(optimizer = \"adam\", loss = \"binary_crossentropy\", metrics = [\"binary_accuracy\"])\n",
        "history = model.fit(x_train, y_train, epochs = 1000, verbose=0)"
      ]
    },
