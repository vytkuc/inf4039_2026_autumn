          "output_type": "stream",
          "name": "stdout",
          "text": [
            "0.05395447126962589\n"
          ]
        }
      ],
      "source": [
        "loss = 0.5 * np.sum((y_true - y_pred) ** 2)\n",
        "print(loss)"
      ]
    },
    {
