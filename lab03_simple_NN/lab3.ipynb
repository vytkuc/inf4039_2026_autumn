      "source": [
        "import numpy as np\n",
        "\n",
        "y_true = 1\n",
        "lr = 0.1\n",
        "\n",
        "x1 = 0.5\n",
        "x2 = -0.2\n",
        "x3 = 0.15\n",
        "x = [x1, x2, x3]\n",
        "\n",
        "w1 = 0.2\n",
        "w2 = 2.0\n",
        "w3 = 0.1\n",
        "w = [w1, w2, w3]\n",
        "\n",
        "#or w0\n",
        "b = 1\n",
        "\n",
        "net = np.dot(x, w) + b\n",
        "print(net)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 21,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
