          "name": "stdout",
          "text": [
            "-0.07246139815304761\n"
          ]
        }
      ],
      "source": [
        "neuron_error = (y_pred - y_true) * (1 - y_pred) * y_pred\n",
        "print(neuron_error)"
      ]
